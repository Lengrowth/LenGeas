{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lengeas.com/domain/ledger-transaction.schema.json",
  "title": "Append-only double-entry economy transaction",
  "type": "object",
  "additionalProperties": false,
  "required": ["transaction_id", "studio_id", "game_id", "player_id", "reason", "source", "actor_id", "definition_digest", "entries", "occurred_at"],
  "properties": {
    "transaction_id": {"type": "string", "minLength": 1},
    "studio_id": {"type": "string", "minLength": 1},
    "game_id": {"type": "string", "minLength": 1},
    "player_id": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "definition_digest": {"type": "string", "minLength": 1},
    "compensates_transaction_id": {"type": ["string", "null"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "entries": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["entry_id", "account_id", "asset_id", "amount", "balance_after"],
      "properties": {
        "entry_id": {"type": "string", "minLength": 1},
        "account_id": {"type": "string", "minLength": 1},
        "asset_id": {"type": "string", "minLength": 1},
        "amount": {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
        "balance_after": {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807}
      }
    }
  }
}
