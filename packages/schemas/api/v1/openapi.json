{
  "components": {
    "schemas": {
      "CredentialRotateRequest": {
        "additionalProperties": false,
        "properties": {
          "identity_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Identity Id",
            "type": "string"
          },
          "refresh_token": {
            "maxLength": 256,
            "minLength": 20,
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "identity_id",
          "refresh_token"
        ],
        "title": "CredentialRotateRequest",
        "type": "object"
      },
      "GuestCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "device_public_key": {
            "maxLength": 128,
            "minLength": 32,
            "title": "Device Public Key",
            "type": "string"
          },
          "turnstile_proof": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Turnstile Proof",
            "type": "string"
          }
        },
        "required": [
          "turnstile_proof",
          "device_public_key"
        ],
        "title": "GuestCreateRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IdentityLinkRequest": {
        "additionalProperties": false,
        "properties": {
          "provider": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Provider",
            "type": "string"
          },
          "provider_proof": {
            "anyOf": [
              {
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Proof"
          },
          "subject": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "subject"
        ],
        "title": "IdentityLinkRequest",
        "type": "object"
      },
      "InvitationRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "role": {
            "pattern": "^(admin|developer|designer|writer|analyst|support|viewer|ai_agent)$",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "email",
          "role"
        ],
        "title": "InvitationRequest",
        "type": "object"
      },
      "MembershipRequest": {
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Account Id",
            "type": "string"
          },
          "role": {
            "pattern": "^(admin|developer|designer|writer|analyst|support|viewer|ai_agent)$",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "account_id",
          "role"
        ],
        "title": "MembershipRequest",
        "type": "object"
      },
      "MergeCommitRequest": {
        "additionalProperties": false,
        "properties": {
          "choices": {
            "additionalProperties": {
              "type": "string"
            },
            "maxProperties": 100,
            "title": "Choices",
            "type": "object"
          },
          "idempotency_key": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Idempotency Key",
            "type": "string"
          },
          "preview_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Preview Id",
            "type": "string"
          },
          "source_credential": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 20,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Credential"
          },
          "target_credential": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 20,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Credential"
          }
        },
        "required": [
          "preview_id",
          "idempotency_key"
        ],
        "title": "MergeCommitRequest",
        "type": "object"
      },
      "MergePreviewRequest": {
        "additionalProperties": false,
        "properties": {
          "source_credential": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 20,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Credential"
          },
          "source_player_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Source Player Id",
            "type": "string"
          },
          "target_credential": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 20,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Credential"
          },
          "target_player_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Target Player Id",
            "type": "string"
          }
        },
        "required": [
          "source_player_id",
          "target_player_id"
        ],
        "title": "MergePreviewRequest",
        "type": "object"
      },
      "PrivacyOperation": {
        "enum": [
          "export",
          "correction",
          "deletion",
          "restriction",
          "legal_hold"
        ],
        "title": "PrivacyOperation",
        "type": "string"
      },
      "PrivacyRequestModel": {
        "additionalProperties": false,
        "properties": {
          "operation": {
            "pattern": "^(export|correction|deletion|restriction|legal_hold)$",
            "title": "Operation",
            "type": "string"
          }
        },
        "required": [
          "operation"
        ],
        "title": "PrivacyRequestModel",
        "type": "object"
      },
      "RoleChangeRequest": {
        "additionalProperties": false,
        "properties": {
          "membership_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Membership Id",
            "type": "string"
          },
          "role": {
            "pattern": "^(admin|developer|designer|writer|analyst|support|viewer|ai_agent)$",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "membership_id",
          "role"
        ],
        "title": "RoleChangeRequest",
        "type": "object"
      },
      "ServiceAccountRequest": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Scopes",
            "type": "array"
          }
        },
        "required": [
          "name",
          "scopes"
        ],
        "title": "ServiceAccountRequest",
        "type": "object"
      },
      "StudioCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "pattern": "^[a-z][a-z0-9-]{2,63}$",
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "name",
          "slug"
        ],
        "title": "StudioCreateRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
