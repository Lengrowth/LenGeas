{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lengeas.local/schemas/governance/requirement-register.schema.json",
  "title": "LenGeas Phase 00 Requirement Register",
  "type": "object",
  "required": ["schema_version", "record_type", "phase", "task", "status", "register_id", "source_matrix", "extraction_rule", "requirements", "review"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "record_type": {"type": "string", "const": "requirement_register"},
    "phase": {"type": "string", "const": "00"},
    "task": {"type": "string", "const": "P00-T02"},
    "status": {"type": "string", "enum": ["in_review", "accepted"]},
    "register_id": {"type": "string", "const": "requirement-register-phase-00"},
    "source_matrix": {"type": "string", "minLength": 1},
    "extraction_rule": {"type": "string", "minLength": 1},
    "requirements": {"type": "array", "minItems": 25, "items": {"$ref": "#/$defs/requirement"}},
    "mandatory_controls": {"type": "array", "minItems": 24, "items": {"$ref": "#/$defs/mandatory_control"}},
    "review": {"type": "object", "required": ["owners_assigned_by_role", "owner_approval", "orphan_requirements"], "properties": {"owners_assigned_by_role": {"const": true}, "owner_approval": {"type": "string"}, "orphan_requirements": {"type": "string"}}, "additionalProperties": false}
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "required": ["id", "title", "owner_role", "source_anchors", "phase_tasks", "verification_method", "evidence_path"],
      "properties": {
        "id": {"type": "string", "pattern": "^RQ-[0-9]{3}$"},
        "title": {"type": "string", "minLength": 1},
        "owner_role": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "source_anchors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "phase_tasks": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^P[0-9]{2}-T[0-9]{2}$"}},
        "verification_method": {"type": "string", "minLength": 1},
        "evidence_path": {"type": "string", "pattern": "^docs/evidence/"}
      },
      "additionalProperties": false
    },
    "mandatory_control": {
      "type": "object",
      "required": ["id", "statement", "source_anchor", "owner_role", "phase_task", "verification_method", "evidence_path"],
      "properties": {
        "id": {"type": "string", "pattern": "^MC-[0-9]{3}$"},
        "statement": {"type": "string", "minLength": 1},
        "source_anchor": {"type": "string", "minLength": 1},
        "owner_role": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "phase_task": {"type": "string", "pattern": "^P[0-9]{2}-T[0-9]{2}$"},
        "verification_method": {"type": "string", "minLength": 1},
        "evidence_path": {"type": "string", "pattern": "^docs/evidence/"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
